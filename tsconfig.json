{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "types": ["node"],

    "outDir": "./dist",
    "rootDir": "./",

    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force"
  },
  "include": ["src/**/*", "prisma.config.ts"]
}